<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MH Time - NTP Server Manager"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCurrentNtp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Active NTP Server: -"
            android:textColor="#B0BEC5"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRefreshCurrent"
            android:layout_width="110dp"
            android:layout_height="42dp"
            android:backgroundTint="#263238"
            android:focusable="true"
            android:text="Refresh"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenServerDialog"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="#263238"
            android:focusable="true"
            android:text="Select NTP Server"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRescanAll"
            android:layout_width="120dp"
            android:layout_height="54dp"
            android:backgroundTint="#37474F"
            android:focusable="true"
            android:text="Re-scan"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Selected: -"
        android:textColor="#90CAF9"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvTestResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ISP Test: Auto scanning..."
        android:textColor="#80CBC4"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTestServer"
            android:layout_width="185dp"
            android:layout_height="54dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#37474F"
            android:focusable="true"
            android:text="Test Selected"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="210dp"
            android:layout_height="54dp"
            android:backgroundTint="#00897B"
            android:focusable="true"
            android:text="Sync Now"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSyncStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Status: Ready"
        android:textColor="#FFD54F"
        android:textSize="16sp" />

</LinearLayout>
